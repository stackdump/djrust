{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "bw": "https://bitwrap.io/ns#",
    "BitwrapCredential": "bw:BitwrapCredential",
    "BitwrapDisclosure": "bw:BitwrapDisclosure",
    "BitwrapInvite": "bw:BitwrapInvite",
    "BitwrapInviteAccept": "bw:BitwrapInviteAccept",
    "BitwrapRevocation": "bw:BitwrapRevocation",
    "BitwrapChartClaim": "bw:BitwrapChartClaim",
    "BitwrapSnapshotShare": "bw:BitwrapSnapshotShare",
    "BeatsShare": "bw:BeatsShare",
    "BeatsDiscoveryClaim": "bw:BeatsDiscoveryClaim",
    "BeatsPost": "bw:BeatsPost",
    "DjSnapshot": "bw:DjSnapshot",
    "v": "bw:formatVersion",
    "disclosureRoot": "bw:disclosureRoot",
    "documentHash": "bw:documentHash",
    "disclosed": { "@id": "bw:disclosed", "@type": "@json" },
    "inviter": { "@id": "bw:inviter", "@type": "@id" },
    "member": { "@id": "bw:member", "@type": "@json" },
    "invite": "bw:invite",
    "code": "bw:inviteCode",
    "securedIn": { "@id": "bw:securedIn", "@type": "@json" },
    "chartedBy": { "@id": "bw:chartedBy", "@type": "@id" },
    "render": { "@id": "bw:render", "@type": "@json" },
    "discoverer": { "@id": "bw:discoverer", "@type": "@id" },
    "snapshotCID": "bw:snapshotCID",
    "text": "bw:text",
    "parent": "bw:parent"
  }
}
